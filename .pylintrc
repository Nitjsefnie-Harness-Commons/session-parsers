[MASTER]

# Every disable below is a pattern this codebase uses deliberately, not a
# finding waved through. The gate exists for real defects; a rule the code
# structurally cannot satisfy is the one that trains people to ignore output.
[MESSAGES CONTROL]
disable=
    line-too-long,
    missing-function-docstring,
    missing-module-docstring,
    missing-class-docstring,
    unused-argument,
    import-error,
    invalid-name,
    broad-exception-caught,
    broad-exception-raised,
    global-statement,
# parse_codex.py formats with % throughout, deliberately and consistently:
# its output is column-aligned tables, and %-8s/%10s state a column width where
# an f-string states padding arithmetic. Converting one file to f-strings to
# satisfy a preference would leave the repo with two formatting dialects.
    consider-using-f-string,
# Three parsers for three unrelated transcript formats, deliberately sharing no
# code -- each must be readable and changeable without regard to the others.
# They land on the same idioms for argument parsing and table emission, and
# that repetition is the price of the independence, not an oversight.
    duplicate-code,
# These are single-file command-line tools: a helper's parameter naming a
# module-level constant is how they are written, not a shadowing accident.
    redefined-outer-name,
# Size and branch metrics. These functions are long because a transcript
# format's cases belong together; splitting them to satisfy a counter would
# make the format harder to verify against, not easier.
    too-many-lines,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-return-statements,
    too-many-nested-blocks,
    too-many-arguments,
    too-many-positional-arguments,
    too-many-instance-attributes,
    too-many-public-methods,
    too-many-boolean-expressions,
# `bar` here is a progress bar, not a placeholder name; pylint's default
# bad-names list assumes foo/bar/baz always mean "example".
    disallowed-name,
# Layout preferences on branches that read as a table of cases.
    no-else-return,
    consider-using-in,
    consider-using-enumerate,
# `x == []` in a suite asserts the value is an empty LIST, not merely falsy.
# The suggested `not x` would also accept None, 0 and "" -- a weaker test.
    use-implicit-booleaness-not-comparison
max-attributes=30
max-args=10
max-positional-arguments=10
min-similarity-lines=15
